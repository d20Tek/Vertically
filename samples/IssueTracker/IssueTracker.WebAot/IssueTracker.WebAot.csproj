<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>IssueTracker.WebAot</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <IsPackable>false</IsPackable>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- Blazor Server itself is not trim/AOT-compatible (IL2026/IL2111 from AddRazorComponents and
         generated Razor code). Keep those visible as warnings instead of failing the build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2111</WarningsNotAsErrors>
    <!-- Trimmed publishes disable reflection-based System.Text.Json; Blazor Server still needs it. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IssueTracker.Application\IssueTracker.Application.csproj" />
    <ProjectReference Include="..\IssueTracker.Persistence\IssueTracker.Persistence.csproj" />
  </ItemGroup>

  <!-- EF Core is not trim-safe (it creates converters and other services via reflection), and
       Blazor Server creates components via reflection, so keep EF, Blazor, and the app's own
       assemblies whole. Everything else (including D20Tek.Vertically) is trimmed. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore" />
    <TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore.Relational" />
    <TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <TrimmerRootAssembly Include="Microsoft.Data.Sqlite" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Components" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Components.Web" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Components.Forms" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Components.Endpoints" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Components.Server" />
    <TrimmerRootAssembly Include="IssueTracker.WebAot" />
    <TrimmerRootAssembly Include="IssueTracker.Persistence" />
    <TrimmerRootAssembly Include="IssueTracker.Application" />
  </ItemGroup>

</Project>
